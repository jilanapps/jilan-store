rules_version = '2';
// BDBS Firestore rules v47 (2026-11-23): v46 + request approval (BDBS v95):
// non-admin request create must be approval 'pending' (or absent); only the
// admin changes approval; pushEvents types request_needs_approval/request_rejected.
// BDBS Firestore rules v46 (2026-11-23): v45 + donor reviews (/donorReviews,
// /donorReviewsPublic) + app feedback (/appFeedback) + pushEvents types
// new_feedback/new_review. NOTHING else changed.
// BDBS Firestore rules v45 (2026-11-22): v44 + push notification
// collections — /pushEvents (v86) and /fcmTokens (v86). NOTHING else
// changed. NOT PUBLISHED by the agent — parent publishes via Console.
// a member doc with a non-empty protectedBy (owner admin email) may be
// updated, deleted or (re)created ONLY by that owner. Applies to /members
// and /membersPublic (create/update/delete). When protectedBy is absent or
// empty, the v43 admin/linked-member rules apply unchanged. NOTHING else
// changed. NOT PUBLISHED by the agent — parent publishes via Console.
// /donors + /donorsPublic create allowlists gain 'referredBy' (C),
// 'lat'/'lng' (B, with range checks); new collections /announcements (A),
// /bloodBanks + /hospitals (B), /camps + /campRegs (D). /requests +
// /requestsPublic create is already `if true`, so recurring fields (D3)
// and SOS (A4) need no rule change. NOT PUBLISHED by the agent —
// publish together with the v57 APK. .exists on a get() result ERRORS
// in evaluation and denies the request (linked member-card read denied).
// All such uses replaced with the exists() function (see helpers below).
service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN = the society account + the owner's account (jilanappsofficial).
    // No other signed-in user is admin. (v33, 2026-11-16: second admin added;
    // society admin untouched.)
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'bastidawabloodsociety@gmail.com'
          || request.auth.token.email == 'jilanappsofficial@gmail.com');
    }

    // The signed-in user's linked donor record id (from their users doc).
    // v36: exists() function — never .exists on a get() result (it errors).
    function linkedDonorId() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(p) ? get(p).data.get('linkedDonorId', '') : '';
    }

    // The signed-in user's linked member record id (from their users doc).
    // v36: exists() function — never .exists on a get() result (it errors).
    function linkedMemberId() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(p) ? get(p).data.get('linkedMemberId', '') : '';
    }

    // The signed-in user's normalized phone (from their users doc).
    // Returns '' when the user has no users doc or no phone on it.
    // v36: .exists on a get() result ERRORS and denies the whole request
    // (found 2026-11-16: linked member-card read denied). Use exists().
    function myPhoneNorm() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(p) ? get(p).data.get('phoneNorm', '') : '';
    }

    // The signed-in user's linked donor's blood group (v45, for push
    // targeting). Returns '' when the user has no linked donor.
    function myGroupFromLink() {
      let u = /databases/$(database)/documents/users/$(request.auth.uid);
      let did = exists(u) ? get(u).data.get('linkedDonorId', '') : '';
      let d = /databases/$(database)/documents/donors/$(did);
      return (did != '' && exists(d)) ? get(d).data.get('group', '') : '';
    }

    // User accounts created by Sign Up: role is always 'donor'.
    // Admin status comes from the email allowlist above, never from role.
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'donor'
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'phone', 'phoneNorm']);
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'linkedDonorId', 'linkedDonorNo', 'linkedMemberId', 'linkedMemberNo', 'phoneNorm']));
      allow delete: if isAdmin();
    }

    // Full donor records (phone, CNIC, address, disease, father name).
    // READ is never public — admin only, except: the linked donor may READ their
    // own record, UPDATE only lastDonation/units, and LINK it (set
    // linkedUid to their own uid, only while it is still unset).
    // CREATE is public so anyone can register as a donor without login;
    // the field list is fixed and linkedUid cannot be set at create
    // time, so a public write can never claim or read a record.
    match /donors/{id} {
      allow read: if isAdmin() || (request.auth != null
        && resource.data.get('linkedUid', null) == request.auth.uid);
      allow create: if isAdmin() || (request.resource.data.keys().hasOnly(['id','name','father','gender','publicOptIn','available','donorNo','photo','cnic','group','age','address','area','phone','disease','lastDonation','units','consent','consentAt','createdAt','demo','referredBy','lat','lng','sponsor','family'])
        && !('linkedUid' in request.resource.data)
        && (!('lat' in request.resource.data) || (request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
        && (!('lng' in request.resource.data) || (request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180)));
      // v37: admin may update anything EXCEPT publicOptIn (a female
      // record goes public only by her own choice — see the owner rule).
      allow update: if (isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['publicOptIn']))
        || (request.auth != null
        && resource.data.get('linkedUid', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastDonation', 'units', 'publicOptIn', 'available', 'lastReqNo', 'lastReqId']));
      // v40: admin privacy toggle — admin may change ONLY publicOptIn
      // (both directions: Private when hiding, Public when the donor
      // gives permission). Changing publicOptIn together with any other
      // field is still denied.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicOptIn']);
      allow update: if request.auth != null
        && resource.data.get('linkedUid', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid'])
        && request.resource.data.linkedUid == request.auth.uid;
      // Requester-anchored donation credit (v23): when a requester closes
      // their own request with a donor attached, the donor's lastDonation
      // and units are credited. Allowed ONLY for the donor named on a
      // Completed request whose requester phone matches the signed-in
      // user's phone — so nobody can credit an unrelated donor.
      allow update: if request.auth != null && myPhoneNorm() != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastDonation', 'units', 'lastClosedRequestId'])
        && request.resource.data.get('lastClosedRequestId', '') != ''
        && exists(/databases/$(database)/documents/requests/$(request.resource.data.lastClosedRequestId))
        && get(/databases/$(database)/documents/requests/$(request.resource.data.lastClosedRequestId)).data.get('donatedById', '') == id
        && get(/databases/$(database)/documents/requests/$(request.resource.data.lastClosedRequestId)).data.get('status', '') == 'Completed'
        && get(/databases/$(database)/documents/requests/$(request.resource.data.lastClosedRequestId)).data.get('requesterPhoneNorm', '') == myPhoneNorm();
      allow delete: if isAdmin();
    }
    // Public-safe donor mirror: name, blood group, city, phone, address,
    // last donation only. Written by the app together with the full
    // record. CREATE is public (same as the full record, same reason).
    // The linked donor may update only their own lastDonation/units here too.
    match /donorsPublic/{id} {
      allow read: if true;
      allow create: if isAdmin() || request.resource.data.keys().hasOnly(['id','name','donorNo','group','city','area','phone','address','lastDonation','units','gender','publicOptIn','available','phoneHash','hidden','createdAt','demo','lat','lng','referredBy','verifiedDonor','sponsor','family'])
        && (!('lat' in request.resource.data) || (request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
        && (!('lng' in request.resource.data) || (request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180));
      allow update: if (isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['publicOptIn']))
        || (request.auth != null && linkedDonorId() == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastDonation', 'units', 'available', 'publicOptIn']));
      // v40: admin privacy toggle — admin may change ONLY publicOptIn
      // (both directions: Private when hiding, Public when the donor
      // gives permission). Changing publicOptIn together with any other
      // field is still denied.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicOptIn']);
      // Same requester-anchored credit as /donors above (v23).
      allow update: if request.auth != null && myPhoneNorm() != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastDonation', 'units', 'lastClosedRequestId'])
        && request.resource.data.get('lastClosedRequestId', '') != ''
        && exists(/databases/$(database)/documents/requests/$(request.resource.data.lastClosedRequestId))
        && get(/databases/$(database)/documents/requests/$(request.resource.data.lastClosedRequestId)).data.get('donatedById', '') == id
        && get(/databases/$(database)/documents/requests/$(request.resource.data.lastClosedRequestId)).data.get('status', '') == 'Completed'
        && get(/databases/$(database)/documents/requests/$(request.resource.data.lastClosedRequestId)).data.get('requesterPhoneNorm', '') == myPhoneNorm();
      // v37: the linked donor may delete her OWN public mirror, so the
      // app can swap it for a private stub when she opts out.
      allow delete: if isAdmin() || (request.auth != null && linkedDonorId() == id);
    }

    // Donor No. -> donor doc lookup, so a signed-up donor can link their
    // own record. Maps a donor number to a doc id only — no private data.
    // CREATE is public (written together with a donor registration);
    // create never overwrites an existing doc, only the admin can change one.
    match /donorLookup/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Donor duplicate-check keys: SHA-256 hashes of a donor's phone /
    // CNIC only — no private data inside. Anyone may read and create
    // them; that is how the "one phone / one CNIC = one donor" check
    // works for public visitors on any phone. Only the admin may
    // update or delete a key (e.g. when a donor record is removed).
    match /donorKeys/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','donorId','kind','createdAt']);
      allow update, delete: if isAdmin();
    }

    // Full member records. NEVER public — admin only, except: the linked
    // member may READ their own record (via linkedMemberId in users doc).
    match /members/{memberId} {
      allow read: if isAdmin() || (request.auth != null && linkedMemberId() == memberId);
      // v44: a protected card (non-empty protectedBy) may be created only
      // by its owner, so nobody can lock a card to someone else's email;
      // unprotected creates work as before for any admin.
      allow create: if isAdmin()
        && (request.resource.data.get('protectedBy', '') == ''
          || request.auth.token.email == request.resource.data.get('protectedBy', ''));
      // v44: a protected card may be deleted only by its owner.
      allow delete: if isAdmin()
        && (resource.data.get('protectedBy', '') == ''
          || request.auth.token.email == resource.data.get('protectedBy', ''));
      // v37: admin may update anything EXCEPT publicOptIn; the linked
      // member may update ONLY publicOptIn (her own privacy choice).
      // v44: on a protected card, BOTH branches require the owner.
      allow update: if (isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['publicOptIn'])
        && (resource.data.get('protectedBy', '') == ''
          || request.auth.token.email == resource.data.get('protectedBy', '')))
        || (request.auth != null && linkedMemberId() == memberId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicOptIn'])
        && (resource.data.get('protectedBy', '') == ''
          || request.auth.token.email == resource.data.get('protectedBy', '')));
    }
    // Member ID -> member doc lookup, so a signed-in member can link
    // their own card. Maps a Member ID (001, 002…) to a doc id only.
    match /memberLookup/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Public-safe member mirror for QR verification: photo, name,
    // designation, ID No., blood group, valid till only.
    match /membersPublic/{id} {
      allow read: if true;
      // v37: admin writes as before; the linked member may replace her
      // OWN mirror (delete + create) when she toggles her privacy, and
      // may update ONLY publicOptIn on it.
      // v44: on a protected card, create/update/delete require the owner —
      // otherwise another admin (or a wrongly linked user) could hide the
      // card by deleting its mirror or recreating it as hidden.
      allow create: if (isAdmin() || (request.auth != null && linkedMemberId() == request.resource.data.id))
        && (request.resource.data.get('protectedBy', '') == ''
          || request.auth.token.email == request.resource.data.get('protectedBy', ''));
      allow update: if (isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['publicOptIn'])
        && (resource.data.get('protectedBy', '') == ''
          || request.auth.token.email == resource.data.get('protectedBy', '')))
        || (request.auth != null && linkedMemberId() == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicOptIn'])
        && (resource.data.get('protectedBy', '') == ''
          || request.auth.token.email == resource.data.get('protectedBy', '')));
      allow delete: if (isAdmin() || (request.auth != null && linkedMemberId() == id))
        && (resource.data.get('protectedBy', '') == ''
          || request.auth.token.email == resource.data.get('protectedBy', ''));
    }

    // Blood requests: anyone may SUBMIT a request (public create).
    // Full records (phone, CNIC) are admin-only.
    // v23: the requester may also CLOSE their own request — only setting
    // status to 'Completed' (+ donatedBy/donatedById), and only when the
    // signed-in user's phone matches the request's requesterPhoneNorm.
    match /requests/{id} {
      allow create: if isAdmin() || request.resource.data.get('approval', 'pending') == 'pending';
      allow read, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && myPhoneNorm() != ''
        && myPhoneNorm() == resource.data.get('requesterPhoneNorm', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'donatedBy', 'donatedById', 'donatedByPrivate', 'completedAt'])
        && request.resource.data.status == 'Completed');
    }
    // Public-safe request mirror: patient first name, blood group needed,
    // hospital, city only. Written by the app together with the request.
    // Same requester-close allowance as /requests above (v23).
    match /requestsPublic/{id} {
      allow read: if true;
      allow create: if isAdmin() || request.resource.data.get('approval', 'pending') == 'pending';
      allow delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && myPhoneNorm() != ''
        && myPhoneNorm() == resource.data.get('requesterPhoneNorm', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'donatedBy', 'donatedById', 'donatedByPrivate', 'completedAt'])
        && request.resource.data.status == 'Completed');
    }

    // Public reviews: anyone may post a review (star rating + text);
    // only the admin may change or remove one (v23).
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id', 'name', 'stars', 'text', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // Daily activities: public to read, admin to publish.
    match /activities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Appreciation certificates: admin only to write. READ is public by
    // design — the donor shares the PDF, and the QR printed on it links
    // to the public verify page (?cert=<ref>). A certificate carries only
    // name, blood group, units and date — the same details already public
    // on the donor list. No phone or CNIC is stored in a certificate.
    match /certificates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Yearly certificate counters (BDBS-CERT-YYYY-XXXX) + the v40
    // allocation counters (counters/members, counters/donors, counters/requests).
    // members + cert counters stay admin-only. counters/donors and
    // counters/requests are
    // readable by anyone (it is only a number) and may be created /
    // incremented by a public registration / request — but ONLY by exactly
    // +1, so nobody can reserve or jump the number sequence.
    // (v34, 2026-11-16 — needed by the v40 transaction in submitDonor;
    // v35 adds counters/requests for the v42 transaction in submitRequestTx.)
    match /counters/{id} {
      allow read: if isAdmin() || id == 'donors' || id == 'requests';
      allow create: if isAdmin() || (id == 'donors' || id == 'requests'
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int
        && request.resource.data.n >= 1);
      allow update: if isAdmin() || (id == 'donors' || id == 'requests'
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int
        && request.resource.data.n == resource.data.n + 1);
      allow delete: if isAdmin();
    }

    // Donation claims: a logged-in LINKED donor marks "I Donated" for an
    // open request of their own blood group. Create only by that linked
    // donor (donorId must match their link), so a random visitor cannot
    // file claims for other donors. The admin reads/updates/deletes;
    // the claimant may read their own claim.
    match /donationClaims/{id} {
      allow read: if isAdmin() || (request.auth != null
        && resource.data.get('donorId', '') == linkedDonorId());
      allow create: if request.auth != null && linkedDonorId() != ''
        && request.resource.data.donorId == linkedDonorId()
        && request.resource.data.keys().hasOnly(['id','requestId','donorId','donorName','group','status','createdAt'])
        && request.resource.data.status == 'Pending';
      allow update, delete: if isAdmin();
    }

    // Admin announcements (v57-A): public to read, admin only to publish.
    // Title/text only — no donor phone, CNIC or private data ever goes in one.
    match /announcements/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'title', 'text', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Blood banks (v57-B): admin-entered stock per blood group.
    // Public read (home list + live stock dashboard); admin only to write.
    match /bloodBanks/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['id','name','city','phone','stock','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1
        && request.resource.data.stock is map
        && request.resource.data.stock.keys().hasOnly(['A+','A-','B+','B-','O+','O-','AB+','AB-']);
      allow update, delete: if isAdmin();
    }

    // Hospitals (v57-B): anyone may REGISTER, but born UNAPPROVED
    // (approved == false) and the public may never flip that flag —
    // only the admin approves. The app gates requests on approved === true.
    match /hospitals/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','name','city','phone','approved','createdAt'])
        && request.resource.data.approved == false
        && request.resource.data.name is string && request.resource.data.name.size() >= 1
        && request.resource.data.city is string && request.resource.data.city.size() >= 1
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Blood donation camps (v57-D): public list, admin-managed.
    match /camps/{campId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'title', 'place', 'date', 'time', 'notes', 'createdAt', 'photos']);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'place', 'date', 'time', 'notes', 'photos']);
      allow delete: if isAdmin();
    }

    // Thalassemia patients (v69; v43 adds 'status' for Close/Reopen): full record is admin-only (patient
    // phone is private); the public mirror has no phone and is readable
    // by everyone, so the Home list can show patients + matching donors.
    match /thalassemiaPatients/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'name', 'group', 'hospital', 'need', 'phone', 'createdAt', 'status']);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'group', 'hospital', 'need', 'phone', 'status']);
      allow delete: if isAdmin();
    }
    match /thalassemiaPatientsPublic/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'name', 'group', 'hospital', 'need', 'createdAt', 'status']);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'group', 'hospital', 'need', 'status']);
      allow delete: if isAdmin();
    }

    // Camp registrations (v57-D): a SIGNED-IN donor creates exactly one
    // row per camp for THEMSELVES — donorId must equal their linked donor
    // record and phoneNorm must match their users doc, so nobody can
    // register someone else. Admin only reads the full list / deletes.
    match /campRegs/{regId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.donorId == linkedDonorId()
        && request.resource.data.phoneNorm == myPhoneNorm()
        && request.resource.data.keys().hasOnly(['id', 'campId', 'donorId', 'name', 'group', 'phone', 'phoneNorm', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // Push notification events (v45, BDBS v86): one doc per event —
    // {id, type, title, body, targetUid, targetGroup, targetPhoneNorm,
    // targetRole, reqNo, createdAt}. Any signed-in user may CREATE
    // (best-effort from the app: the write must never block the main
    // flow); title/body are length-capped and the type allowlist keeps
    // the collection abuse-proof. READ is targeted: admin reads all;
    // a user reads an event only when it is addressed to them (their
    // uid, their phone, their blood group, or a broadcast). No update
    // or delete from the client — events are a write-once log.
    // Bodies never contain CNIC, full address or disease info — only
    // blood group, hospital/city and first name (public policy).
    match /pushEvents/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['id', 'type', 'title', 'body', 'targetUid', 'targetGroup', 'targetPhoneNorm', 'targetRole', 'reqNo', 'createdAt'])
        && request.resource.data.type in ['new_request', 'donor_found', 'donation_confirmed', 'cooldown_ready', 'new_member', 'broadcast', 'new_feedback', 'new_review', 'request_needs_approval', 'request_rejected']
        && request.resource.data.title.size() <= 120
        && request.resource.data.body.size() <= 300;
      allow read: if isAdmin() || (request.auth != null
        && (resource.data.get('targetUid', '') == request.auth.uid
          || resource.data.get('targetPhoneNorm', '') == myPhoneNorm()
          || (resource.data.get('targetGroup', '') != '' && resource.data.get('targetGroup', '') == myGroupFromLink())
          || resource.data.get('targetRole', '') == 'all'));
    }

    // FCM device tokens (v45, BDBS v86): one doc per user —
    // {uid, group, role, platform, tokens[], updatedAt}. Only the owner
    // may write their own tokens (and only their own uid); admin may
    // read for targeting, the owner may read their own. No delete from
    // the client. Tokens are capped at 5 per user.
    match /fcmTokens/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'group', 'role', 'platform', 'tokens', 'updatedAt'])
        && request.resource.data.tokens.size() <= 5;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Donor reviews (v46, BDBS v94): the requester rates the donor who
    // donated for their request — 1..5 stars + optional thanks (<=200).
    // Doc id = requestId + '_' + donorId, so ONE review per donor per
    // request (a second create is an update and is denied). The request
    // must be the signed-in user's own (phoneNorm match, same check as the
    // v23 requester close), its donatedById must be this donor, and it must
    // be Donor Found / Completed / Closed. Saved as 'pending'; only the
    // admin approves or rejects. Reviewer may read their own review (and
    // check that it does not exist yet).
    match /donorReviews/{id} {
      allow create: if request.auth != null && myPhoneNorm() != ''
        && request.resource.data.keys().hasOnly(['id', 'requestId', 'reqNo', 'donorId', 'donorName', 'reviewerUid', 'reviewerFirst', 'stars', 'text', 'status', 'createdAt'])
        && request.resource.data.id == id
        && request.resource.data.requestId is string && request.resource.data.donorId is string
        && id == request.resource.data.requestId + '_' + request.resource.data.donorId
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 200
        && request.resource.data.reviewerFirst is string
        && request.resource.data.reviewerFirst.size() >= 1 && request.resource.data.reviewerFirst.size() <= 40
        && request.resource.data.donorName is string && request.resource.data.donorName.size() <= 80
        && request.resource.data.reqNo is string && request.resource.data.reqNo.size() <= 30
        && request.resource.data.createdAt is int
        && exists(/databases/$(database)/documents/requestsPublic/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/requestsPublic/$(request.resource.data.requestId)).data.get('requesterPhoneNorm', '') == myPhoneNorm()
        && get(/databases/$(database)/documents/requestsPublic/$(request.resource.data.requestId)).data.get('donatedById', '') == request.resource.data.donorId
        && get(/databases/$(database)/documents/requestsPublic/$(request.resource.data.requestId)).data.get('status', '') in ['Donor Found', 'Completed', 'Closed'];
      allow read: if isAdmin() || (request.auth != null
        && (resource == null || resource.data.get('reviewerUid', '') == request.auth.uid));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isAdmin();
    }
    // Approved review mirror (v46): written ONLY by the admin on approval.
    // Reviewer FIRST NAME only — never phone, CNIC, address or disease.
    // Readable by signed-in users (donor list badge + thanks list).
    match /donorReviewsPublic/{id} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'donorId', 'reviewerFirst', 'stars', 'text', 'createdAt'])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 200
        && request.resource.data.reviewerFirst is string && request.resource.data.reviewerFirst.size() <= 40;
      allow delete: if isAdmin();
    }
    // App feedback (v46): any signed-in member sends a Suggestion /
    // Complaint / Praise to the admin. Private — admin reads, marks read,
    // deletes. Never public.
    match /appFeedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['id', 'type', 'text', 'name', 'uid', 'email', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['Suggestion', 'Complaint', 'Praise']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.email is string && request.resource.data.email.size() <= 100
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is int;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt']);
    }

    // Audit log (v40): one doc per admin action — {id, adminEmail,
    // action, target, detail, createdAt}. Admin-only to create AND
    // read; never updated or deleted, so the trail cannot be edited
    // away. Writes are best-effort in the app: until these v34 rules
    // are published the server rejects audit writes, and the admin
    // action itself still succeeds.
    match /auditLog/{id} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'adminEmail', 'action', 'target', 'detail', 'createdAt'])
        && request.resource.data.adminEmail == request.auth.token.email;
      allow read: if isAdmin();
    }
  }
}
