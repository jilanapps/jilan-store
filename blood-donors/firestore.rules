rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN = ONLY the society account. No other signed-in user is admin.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'bastidawabloodsociety@gmail.com';
    }

    // The signed-in user's linked donor record id (from their users doc).
    function linkedDonorId() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u.exists ? u.data.get('linkedDonorId', '') : '';
    }

    // The signed-in user's linked member record id (from their users doc).
    function linkedMemberId() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u.exists ? u.data.get('linkedMemberId', '') : '';
    }

    // User accounts created by Sign Up: role is always 'donor'.
    // Admin status comes from the email allowlist above, never from role.
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'donor'
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'phone']);
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'linkedDonorId', 'linkedDonorNo', 'linkedMemberId', 'linkedMemberNo']));
      allow delete: if isAdmin();
    }

    // Full donor records (phone, CNIC, address, disease, father name).
    // READ is never public — admin only, except: the linked donor may READ their
    // own record, UPDATE only lastDonation/units, and LINK it (set
    // linkedUid to their own uid, only while it is still unset).
    // CREATE is public so anyone can register as a donor without login;
    // the field list is fixed and linkedUid cannot be set at create
    // time, so a public write can never claim or read a record.
    match /donors/{id} {
      allow read: if isAdmin() || (request.auth != null
        && resource.data.get('linkedUid', null) == request.auth.uid);
      allow create: if isAdmin() || (request.resource.data.keys().hasOnly(['id','name','father','donorNo','photo','cnic','group','age','address','phone','disease','lastDonation','units','createdAt','demo'])
        && !('linkedUid' in request.resource.data));
      allow update: if isAdmin() || (request.auth != null
        && resource.data.get('linkedUid', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastDonation', 'units']));
      allow update: if request.auth != null
        && resource.data.get('linkedUid', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid'])
        && request.resource.data.linkedUid == request.auth.uid;
      allow delete: if isAdmin();
    }
    // Public-safe donor mirror: name, blood group, city, phone, address,
    // last donation only. Written by the app together with the full
    // record. CREATE is public (same as the full record, same reason).
    // The linked donor may update only their own lastDonation/units here too.
    match /donorsPublic/{id} {
      allow read: if true;
      allow create: if isAdmin() || request.resource.data.keys().hasOnly(['id','name','group','city','phone','address','lastDonation','units','createdAt','demo']);
      allow update: if isAdmin() || (request.auth != null && linkedDonorId() == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastDonation', 'units']));
      allow delete: if isAdmin();
    }

    // Donor No. -> donor doc lookup, so a signed-up donor can link their
    // own record. Maps a donor number to a doc id only — no private data.
    // CREATE is public (written together with a donor registration);
    // create never overwrites an existing doc, only the admin can change one.
    match /donorLookup/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Donor duplicate-check keys: SHA-256 hashes of a donor's phone /
    // CNIC only — no private data inside. Anyone may read and create
    // them; that is how the "one phone / one CNIC = one donor" check
    // works for public visitors on any phone. Only the admin may
    // update or delete a key (e.g. when a donor record is removed).
    match /donorKeys/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','donorId','kind','createdAt']);
      allow update, delete: if isAdmin();
    }

    // Full member records. NEVER public — admin only, except: the linked
    // member may READ their own record (via linkedMemberId in users doc).
    match /members/{memberId} {
      allow read: if isAdmin() || (request.auth != null && linkedMemberId() == memberId);
      allow write: if isAdmin();
    }
    // Member ID -> member doc lookup, so a signed-in member can link
    // their own card. Maps a Member ID (001, 002…) to a doc id only.
    match /memberLookup/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Public-safe member mirror for QR verification: photo, name,
    // designation, ID No., blood group, valid till only.
    match /membersPublic/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blood requests: anyone may SUBMIT a request (public create).
    // Full records (phone, CNIC) are admin-only.
    match /requests/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    // Public-safe request mirror: patient first name, blood group needed,
    // hospital, city only. Written by the app together with the request.
    match /requestsPublic/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Daily activities: public to read, admin to publish.
    match /activities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Appreciation certificates: admin only to write; a linked donor may
    // read ONLY certificates of their own linked donor record. (Name,
    // blood group, units, date, reference no. — no phone/CNIC inside.)
    match /certificates/{id} {
      allow read: if isAdmin() || (request.auth != null
        && linkedDonorId() == resource.data.get('donorId', ''));
      allow write: if isAdmin();
    }

    // Yearly certificate counters (BDBS-CERT-YYYY-XXXX).
    match /counters/{id} {
      allow read, write: if isAdmin();
    }
  }
}
